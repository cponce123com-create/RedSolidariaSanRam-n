# Variables de Entorno - Ejemplo
# Copia este archivo a .env y configura tus variables

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ============================================
# API SERVER
# ============================================
# Required en producción - usar un valor seguro único
SESSION_SECRET=tu-secret-key-seguro-cambiar-en-produccion

# URL base de la API (opcional, default: https://api.redsolidaria.com)
API_URL=http://localhost:3000

# Ruta de archivos estáticos en producción
STATIC_FILES_PATH=./artifacts/red-solidaria/dist/public

# ============================================
# BASE DE DATOS
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://usuario:password@localhost:5432/redsolidaria?schema=public

# ============================================
# SEGURIDAD
# ============================================
# Rate limiting (valores por defecto si no se especifican)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FRONTEND (Red Solidaria)
# ============================================
BASE_PATH=/
VITE_API_URL=http://localhost:3000/api

# ============================================
# SERVICIOS EXTERNOS (Opcional)
# ============================================
# Sentry DSN para monitoreo de errores
# SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto

# Google Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Email service (para notificaciones)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-password

# ============================================
# PRODUCCIÓN
# ============================================
# En producción, asegúrate de:
# 1. Usar HTTPS (SESSION_COOKIE_SECURE=true)
# 2. SESSION_SECRET único y seguro
# 3. CORS_ORIGIN específico (no usar *)
# 4. DATABASE_URL con credenciales seguras
# 5. NODE_ENV=production
